@model IEnumerable<string>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<br/>
<br/>

<table class="table">

    <thead>
        <tr> <th>Category</th> </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>
                    @category
                </td>
            </tr>
        }
    </tbody>

</table>