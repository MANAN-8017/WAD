@model Assignment1.Models.Book

<div class="card mb-4">

    <div class="card-body">

        <h5 class="card-title">
            @Model.Title
        </h5>

        <p class="card-text">
            <strong>Author:</strong> @Model.Author
        </p>

        <p class="card-text">
            <strong>Category:</strong> @Model.Category
        </p>

        <p class="card-text">
            <strong>Price:</strong> @Model.Price ₹
        </p>

        <p class="card-text">
            <strong>Published Year:</strong> @Model.PublishedYear
        </p>

        <button>Buy</button>
    </div>

</div>