@page
@model WebApplication1.Pages.UserModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="text-center mb-4">
                <h1 class="display-6">User Details</h1>
                <p class="text-muted">Enter your details below</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email ID
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contact" class="form-label">
                                Contact No
                            </label>

                            <input asp-for="Contact"
                                   class="form-control"
                                   placeholder="Enter your contact number" />

                            <span asp-validation-for="Contact"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Gender" class="form-label">
                                Gender
                            </label>

                            <select asp-for="Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Submit
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>