@page
@model WebApplication1.Pages.ResultModel
@{
    ViewData["Title"] = "User Result";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="text-center mb-4">
                <h1 class="display-6">User Details</h1>
                <p class="text-muted">Submitted user information</p>
            </div>

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">User Information</h5>
                </div>

                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">
                            Name
                        </div>

                        <div class="col-sm-8">
                            @Model.Name
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">
                            Email ID
                        </div>

                        <div class="col-sm-8 text-break">
                            @Model.Email
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">
                            Contact No
                        </div>

                        <div class="col-sm-8">
                            @Model.Contact
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-sm-4 fw-bold">
                            Gender
                        </div>

                        <div class="col-sm-8">
                            @Model.Gender
                        </div>
                    </div>

                </div>

                <div class="card-footer text-end">
                    <a asp-page="/User"
                       class="btn btn-secondary">
                        Back
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>